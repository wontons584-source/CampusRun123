# ============================================================
# CampusRun 环境变量模板
# 用法：复制为 backend/.env 后填入真实值。
#      .env 已被 .gitignore 排除，永远不会进入仓库。
# 禁止在本文件里写真实密钥、真实手机号、真实取件码。
# ============================================================

# ---------- 应用 ----------
APP_ENV=development               # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- 数据库 ----------
# 生产使用 PostgreSQL 16；本地可用 docker compose 内置实例
DATABASE_URL=postgresql+psycopg://campusrun:change-me@localhost:5432/campusrun
DB_POOL_SIZE=10
DB_ECHO=false

# ---------- 缓存 / 地理索引 / 队列 ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- 认证 ----------
JWT_SECRET_KEY=change-me-another-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=120
JWT_REFRESH_TTL_DAYS=30
# 学号认证允许的邮箱后缀，逗号分隔（多校区预留）
VERIFY_EMAIL_DOMAIN_WHITELIST=nau.edu.cn

# ---------- 字段级加密（32 字节，base64 编码）----------
# 生成方式：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PHONE_AES_KEY=
PICK_CODE_AES_KEY=

# ---------- 短信（登录验证码）----------
SMS_PROVIDER=aliyun               # aliyun | tencent | mock
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ---------- 邮件（校园邮箱验证码）----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com

# ---------- 对象存储（兼容 S3 协议）----------
STORAGE_PROVIDER=s3               # s3 | cos | oss | local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
# 本地开发可用本地磁盘，此时填 STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./static/uploads

# ---------- 管理后台 ----------
# 逗号分隔的 CIDR，留空表示不限制（仅开发环境）
ADMIN_IP_ALLOWLIST=
