<Slide style={{ padding: 60, background: '#FFFFFF' }}>
  <Box style={{ flexDirection: 'column', gap: 12, marginBottom: 24 }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.2 }}>
      从一句话需求到一个能跑的系统，我拆成 6 步
    </Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
  </Box>
  <Box style={{ flexDirection: 'row', gap: 12, flex: 1 }}>
    {[
      { n: '①', t: '需求', d: 'PRD + 状态迁移表', skip: false },
      { n: '②', t: '架构', d: 'ADR + 数据模型', skip: false },
      { n: '③', t: '骨架', d: '目录 + 迁移 + 配置', skip: false },
      { n: '④', t: '编码', d: '状态机 + 仓储 + 接口', skip: false },
      { n: '⑤', t: '验证', d: '单测 + 真库 + 并发', skip: false },
      { n: '⑥', t: '收口', d: '文档回写', skip: true },
    ].map((s, i) => (
      <Box key={i} style={{ flex: 1, background: s.skip ? '#FFFFFF' : '#F8FAFC', border: s.skip ? '2px dashed #F59E0B' : '1px solid #E5E7EB', borderRadius: 10, padding: 18, justifyContent: 'center', gap: 10 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: s.skip ? '#F59E0B' : '#2563EB', lineHeight: 1.2 }}>{s.n}</Text>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E293B', lineHeight: 1.3 }}>{s.t}</Text>
        <Text style={{ fontSize: 14, color: '#64748B', lineHeight: 1.4 }}>{s.d}</Text>
      </Box>
    ))}
  </Box>
  <Box style={{ background: '#FEF3C7', borderRadius: 8, padding: 16, marginTop: 22, flexDirection: 'row', alignItems: 'center', gap: 12 }}>
    <Text style={{ fontSize: 17, color: '#1E293B', lineHeight: 1.5, flex: 1 }}>
      <span style={{ fontWeight: 'bold', color: '#B45309' }}>最容易跳步的是 ⑥（收口）。</span>我跳过它，代价是后来有 4 处文档和实现对不上，回查花了一个晚上。
    </Text>
  </Box>
</Slide>
