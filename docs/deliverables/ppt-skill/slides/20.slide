<Slide style={{ padding: 60, background: '#0F172A' }}>
  <Box style={{ flexDirection: 'column', gap: 8, marginBottom: 24 }}>
    <Text style={{ fontSize: 15, color: '#64748B', letterSpacing: 2 }}>
      结语
    </Text>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>
      它擅长什么，不擅长什么
    </Text>
    <Box style={{ width: '100%', height: 1, background: '#1E293B' }} />
  </Box>
  <Box style={{ flexDirection: 'row', gap: 24, flex: 1 }}>
    <Box style={{ flex: 1, background: '#1E293B', borderRadius: 10, padding: 22, gap: 10 }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#06B6D4', lineHeight: 1.3 }}>它很擅长</Text>
      {['把已经想清楚的规则翻译成代码', '生成测试用例的清单', '在 17 条迁移里保持命名编号一致', '一次性重命名、搬移、格式化', '解释一段代码在干什么'].map((s, i) => (
        <Text key={i} style={{ fontSize: 15, color: '#E2E8F0', lineHeight: 1.45 }}>▸ {s}</Text>
      ))}
    </Box>
    <Box style={{ flex: 1, background: '#1E293B', borderRadius: 10, padding: 22, gap: 10 }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#F59E0B', lineHeight: 1.3 }}>它不擅长</Text>
      {['判断规则本身对不对', '判断哪些用例必须跑在真实环境', '发现某条迁移的语义和另一条冲突', '判断这次改动会不会破坏别处', '知道你为什么要这段代码'].map((s, i) => (
        <Text key={i} style={{ fontSize: 15, color: '#E2E8F0', lineHeight: 1.45 }}>▸ {s}</Text>
      ))}
    </Box>
  </Box>
  <Box style={{ marginTop: 24, alignItems: 'center', gap: 8 }}>
    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.4, textAlign: 'center' }}>
      我出判据，它出实现，环境出裁决
    </Text>
    <Text style={{ fontSize: 16, color: '#94A3B8', lineHeight: 1.4, textAlign: 'center' }}>
      它能把想清楚的事写得又快又好，但它没办法替你想清楚。
    </Text>
  </Box>
</Slide>
